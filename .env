# The site's full address, with no trailing slash, e.g. VITE_SITE_URL=https://angelawang.com
# Used for the link-preview tags in index.html (LinkedIn / iMessage need a full URL for the preview image).
# Set this once the site has its domain (here, or as an environment variable in Vercel / Netlify), then rebuild.
VITE_SITE_URL=
